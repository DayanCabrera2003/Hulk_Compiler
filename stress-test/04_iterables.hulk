// Iterables stress test: builtin range, prelude Range, nested loops, while with state.

function isPrime(n: Number): Boolean =>
    if (n < 2) false
    elif (n == 2) true
    elif (n % 2 == 0) false
    else
        let p = true, d = 3 in {
            while (p & (d * d <= n)) {
                if (n % d == 0) p := false;
                d := d + 2;
            };
            p;
        };

function primesUnder(limit: Number) {
    for (n in range(2, limit)) {
        if (isPrime(n)) print(n);
    };
}

{
    print("=== Builtin range ===");
    for (i in range(0, 5)) print(i);
    for (i in range(10, 15)) print(i);

    print("=== new Range ===");
    let r = new Range(0, 4) in {
        while (r.next()) print(r.current());
    };

    print("=== Nested loops ===");
    for (i in range(1, 4)) {
        for (j in range(1, 4)) {
            print(i * j);
        };
    };

    print("=== While with destructive assignment ===");
    let n = 1, count = 0 in {
        while (n <= 100) {
            count := count + 1;
            n := n * 2;
        };
        print(count);
        print(n);
    };

    print("=== Compute factorials with for ===");
    let acc = 1 in {
        for (i in range(1, 6)) acc := acc * i;
        print(acc);
    };

    print("=== Sum of squares ===");
    let sum = 0 in {
        for (i in range(1, 11)) sum := sum + i * i;
        print(sum);
    };

    print("=== Primes under 30 ===");
    primesUnder(30);

    print("=== Counting downwards ===");
    let n = 5 in {
        while (n >= 0) {
            print(n);
            n := n - 1;
        };
    };

    print("=== Two parallel iterators ===");
    let r1 = new Range(0, 3), r2 = new Range(10, 13) in {
        while (r1.next() & r2.next()) {
            print(r1.current() @ " + " @ r2.current() @ " = " @ (r1.current() + r2.current()));
        };
    };
}
