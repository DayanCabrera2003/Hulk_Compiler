// conditionals.hulk — if / elif / else con ramas múltiples y bloques.
// Snippets literales de Hulk.md:362, 383, 396.
{
    let a = 42 in if (a % 2 == 0) print("Even") else print("Odd");

    let a = 42 in
        if (a % 2 == 0) {
            print(a);
            print("Even");
        } else print("Odd");

    let a = 42, m = a % 3 in
        print(
            if (m == 0) "Magic"
            elif (m == 1) "Woke"
            else "Dumb"
        );

    if (true) print("always");
}
