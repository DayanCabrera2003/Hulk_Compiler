// functions.hulk — inline (=>), full-form ({}), recursión, mutuas.
// `cot`/`tan` aparecen en Hulk.md:159-162; `operate` en Hulk.md:174.
// `fib` es el ejemplo clásico de recursión referenciado en Hulk.md.
function cot(x) => 1 \ tan(x);
function tan(x) => sin(x) \ cos(x);

function fib(n) =>
    if (n <= 1) n
    else fib(n - 1) + fib(n - 2);

function operate(x, y) {
    print(x + y);
    print(x - y);
    print(x * y);
    print(x \ y);
}

{
    print(tan(PI) ^ 2 + cot(PI) ^ 2);
    print(fib(10));
    operate(10, 5);
}
