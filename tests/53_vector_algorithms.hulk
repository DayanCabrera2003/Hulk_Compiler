// 53_vector_algorithms.hulk
// Vector algorithm library: sum, product, max, min, dot product, linear search

function sum(v: Number[]): Number {
    let acc = 0 in {
        for (x in v) acc := acc + x;
        acc
    }
}

function product(v: Number[]): Number {
    let acc = 1 in {
        for (x in v) acc := acc * x;
        acc
    }
}

function max_elem(v: Number[]): Number {
    let m = v[0] in {
        let i = 1 in
            while (i < v.size()) {
                if (v[i] > m) m := v[i] else 0;
                i := i + 1
            };
        m
    }
}

function min_elem(v: Number[]): Number {
    let m = v[0] in {
        let i = 1 in
            while (i < v.size()) {
                if (v[i] < m) m := v[i] else 0;
                i := i + 1
            };
        m
    }
}

function dot_product(a: Number[], b: Number[]): Number {
    let acc = 0 in {
        let i = 0 in
            while (i < a.size()) {
                acc := acc + a[i] * b[i];
                i := i + 1
            };
        acc
    }
}

function contains(v: Number[], target: Number): Boolean {
    let found = false in {
        let i = 0 in
            while (i < v.size() & !found) {
                if (v[i] == target) found := true else 0;
                i := i + 1
            };
        found
    }
}

function count_greater(v: Number[], threshold: Number): Number {
    let cnt = 0 in {
        for (x in v) if (x > threshold) cnt := cnt + 1 else 0;
        cnt
    }
}

function mean(v: Number[]): Number =>
    sum(v) \ v.size();

{
    let a = [1, 3, 5, 7, 9, 2, 4, 6, 8, 10] in {
        print("=== Vector A: [1,3,5,7,9,2,4,6,8,10] ===");
        print("Sum:         " @ sum(a));
        print("Product:     " @ product(a));
        print("Max:         " @ max_elem(a));
        print("Min:         " @ min_elem(a));
        print("Mean:        " @ mean(a));
        print("Contains 7:  " @ contains(a, 7));
        print("Contains 11: " @ contains(a, 11));
        print("Count > 5:   " @ count_greater(a, 5))
    };

    let b = [2, 4, 6, 8, 10, 1, 3, 5, 7, 9] in {
        print("=== Dot product A . B ===");
        let a2 = [1, 3, 5, 7, 9, 2, 4, 6, 8, 10] in
            print("A . B = " @ dot_product(a2, b))
    };

    // Single-element edge case
    let single = [42] in {
        print("=== Single-element vector [42] ===");
        print("Sum:  " @ sum(single));
        print("Max:  " @ max_elem(single));
        print("Min:  " @ min_elem(single));
        print("Contains 42: " @ contains(single, 42));
        print("Contains  0: " @ contains(single, 0))
    };

    // Generated + algorithm
    let sq = [x ^ 2 | x in range(1, 6)] in {
        print("=== Squares 1..5 ===");
        print("Sum of squares: " @ sum(sq));
        print("Max square:     " @ max_elem(sq))
    }
}
