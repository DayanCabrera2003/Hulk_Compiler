// 40_loop_sorting_simulation.hulk
// Sorting algorithms using loops.
// Bubble sort and selection sort on vectors with v[i] := val mutation.
// Also demonstrates manual min-finding and ordering on small fixed sequences.

// Print all elements of a vector of 8 elements
function print_vec8(v: Number[]) {
    print(v[0] @ " " @ v[1] @ " " @ v[2] @ " " @ v[3]
        @ " " @ v[4] @ " " @ v[5] @ " " @ v[6] @ " " @ v[7]);
}

// Bubble sort in place (ascending) on 8-element vector
function bubble_sort(v: Number[]): Number[] {
    let n = v.size() in {
        let i = 0 in {
            while (i < n - 1) {
                let j = 0 in {
                    while (j < n - i - 1) {
                        let a = v[j], b = v[j + 1] in {
                            if (a > b) {
                                v[j]     := b;
                                v[j + 1] := a;
                            } else 0;
                        };
                        j := j + 1;
                    };
                };
                i := i + 1;
            };
        };
        v
    }
}

// Selection sort in place (ascending) on 8-element vector
function selection_sort(v: Number[]): Number[] {
    let n = v.size() in {
        let i = 0 in {
            while (i < n - 1) {
                let min_idx = i, j = i + 1 in {
                    while (j < n) {
                        min_idx := if (v[j] < v[min_idx]) j else min_idx;
                        j := j + 1;
                    };
                    let tmp = v[i] in {
                        v[i]       := v[min_idx];
                        v[min_idx] := tmp;
                    };
                };
                i := i + 1;
            };
        };
        v
    }
}

// Insertion sort in place on 8-element vector
function insertion_sort(v: Number[]): Number[] {
    let n = v.size(), i = 1 in {
        while (i < n) {
            let key = v[i], j = i - 1 in {
                while (j >= 0 & v[j] > key) {
                    v[j + 1] := v[j];
                    j := j - 1;
                };
                v[j + 1] := key;
            };
            i := i + 1;
        };
        v
    }
}

{
    print("=== Bubble Sort ===");
    let b = [64, 34, 25, 12, 22, 11, 90, 1] in {
        print("Before: ");
        print_vec8(b);
        bubble_sort(b);
        print("After:  ");
        print_vec8(b);
    };

    print("=== Selection Sort ===");
    let s = [29, 10, 14, 37, 13, 8, 5, 42] in {
        print("Before: ");
        print_vec8(s);
        selection_sort(s);
        print("After:  ");
        print_vec8(s);
    };

    print("=== Insertion Sort ===");
    let ins = [5, 2, 4, 6, 1, 3, 9, 7] in {
        print("Before: ");
        print_vec8(ins);
        insertion_sort(ins);
        print("After:  ");
        print_vec8(ins);
    };

    // Verify: sort a nearly-sorted sequence
    print("=== Nearly-sorted Bubble Sort ===");
    let ns = [1, 2, 3, 5, 4, 6, 7, 8] in {
        print("Before: ");
        print_vec8(ns);
        bubble_sort(ns);
        print("After:  ");
        print_vec8(ns);
    };

    // Show that all three agree on the same input
    print("=== All three on [8,3,7,1,5,4,6,2] ===");
    let v1 = [8, 3, 7, 1, 5, 4, 6, 2] in {
        bubble_sort(v1);
        print("Bubble:    ");
        print_vec8(v1);
    };
    let v2 = [8, 3, 7, 1, 5, 4, 6, 2] in {
        selection_sort(v2);
        print("Selection: ");
        print_vec8(v2);
    };
    let v3 = [8, 3, 7, 1, 5, 4, 6, 2] in {
        insertion_sort(v3);
        print("Insertion: ");
        print_vec8(v3);
    };

    print("Done.");
}
